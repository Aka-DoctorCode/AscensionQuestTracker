<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Font name="AscensionBaseFont" font="Fonts\ARIALN.TTF" virtual="true" outline="NORMAL">
        <FontHeight>
            <AbsValue val="12"/>
        </FontHeight>
    </Font>

    <FontString name="AscensionObjectiveFontTemplate" inherits="AscensionBaseFont" virtual="true" justifyH="RIGHT">
        <Color r="0.8" g="0.8" b="0.8"/>
    </FontString>

    <Button name="AscensionQuestBlockTemplate" virtual="true">
        <Size x="250" y="20"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="AscensionBaseFont" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="TOPRIGHT"/>
                    </Anchors>
                    <Color r="1.0" g="0.82" b="0.0"/>
                </FontString>
            </Layer>
        </Layers>
    </Button>

    <Button name="AscensionQuestItemButtonTemplate" inherits="SecureActionButtonTemplate" virtual="true">
        <Size x="28" y="28"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Button>
</Ui>
